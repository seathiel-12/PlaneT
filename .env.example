VITE_APP_BASE_BACKEND_URL=http://localhost:3000

# EmailJS development settings: Vite exposes VITE_ variables to the browser.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_BLOCKED_EMAILS=

# Server-side EmailJS settings for Vercel's Node function (not bundled by Vite).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_BLOCKED_EMAILS=
